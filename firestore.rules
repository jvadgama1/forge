rules_version = '2';

// Forge security rules (ADR-0005: the repo and web config are public; these
// rules are what protect the data). Only the owner's account may read or
// write, and only its own documents under users/{uid}. Any other Google
// account that signs in is refused everywhere, even under its own root, so it
// can't store anything or use up the free quota (#9). Everything else is
// denied.
service cloud.firestore {
  match /databases/{database}/documents {
    // An allowlist of one: OWNER_UID in app/js/firebase-config.js.
    function isOwner() {
      return request.auth != null
        && request.auth.uid in ['x98Yvmbfj6eBxKbsluJOC3HkcBJ3'];
    }

    match /users/{uid}/{document=**} {
      allow read, write: if isOwner() && request.auth.uid == uid;
    }
  }
}
