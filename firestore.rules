rules_version = '2';

// Forge security rules (ADR-0005: the repo and web config are public; these
// rules are what protect the data). Each signed-in user may read and write
// only their own documents, under users/{uid}. Everything else is denied.
// #9 narrows this further to the owner's account alone.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
