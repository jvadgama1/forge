{
  // Type-check JSDoc-annotated JavaScript; never emit (ADR-0002: no build step).
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    // nodenext requires explicit ".js" extensions, as the browser does with no bundler.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022", "dom", "dom.iterable"],
    "skipLibCheck": true
  },
  // Tooling configs are included so the check has inputs before any app code exists.
  "include": ["app/**/*.js", "tests/**/*.js", "tools/**/*.js", "*.config.js"],
  // The service worker needs the "webworker" lib, which conflicts with "dom";
  // it stays linted but is not type-checked.
  "exclude": ["node_modules", "app/sw.js"]
}
